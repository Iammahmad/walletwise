{
  "expo": {
    "name": "SpendSpeak",
    "slug": "spendspeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/spendspeak-icon.png",
    "scheme": "spendspeak",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spendspeak.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SpendSpeak uses the microphone only when you tap the voice button to transcribe a money entry.",
        "NSSpeechRecognitionUsageDescription": "SpendSpeak uses speech recognition to turn spoken money entries into editable drafts. Audio is not retained."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087F5B",
        "foregroundImage": "./assets/spendspeak-adaptive-foreground.png",
        "monochromeImage": "./assets/spendspeak-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spendspeak.app",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/spendspeak-icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "enableFTS": true }],
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SpendSpeak to use the microphone only while you record a money entry.",
          "speechRecognitionPermission": "Allow SpendSpeak to transcribe spoken money entries into editable drafts.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
