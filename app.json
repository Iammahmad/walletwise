{
  "expo": {
    "name": "SpendSpeak",
    "slug": "spendspeak",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/spendspeak-icon-v2.png",
    "scheme": "spendspeak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spendspeak.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow SpendSpeak to use the microphone only while you record a money entry.",
        "NSSpeechRecognitionUsageDescription": "Allow SpendSpeak to transcribe spoken money entries into editable drafts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3E8",
        "foregroundImage": "./assets/spendspeak-adaptive-foreground-v2.png",
        "monochromeImage": "./assets/spendspeak-adaptive-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spendspeak.app",
      "versionCode": 4,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/spendspeak-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/spendspeak-splash-v2.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101513",
            "image": "./assets/spendspeak-splash-v2.png"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SpendSpeak to use the microphone only while you record a money entry.",
          "speechRecognitionPermission": "Allow SpendSpeak to transcribe spoken money entries into editable drafts.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8f1791d-0f9a-4d04-b824-cf4cb14dcd67"
      }
    }
  }
}
