# Optional. When absent, SpendSpeak runs in local-only mode.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Google OAuth is configured in the Supabase Dashboard, not in the mobile app.
# For a local Supabase stack only, keep the Google secret server-side:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace_me

# Edge Function secrets. Set with `supabase secrets set`; never expose these as EXPO_PUBLIC_*.
# GEMINI_API_KEY=replace_me
# GEMINI_MODEL=gemini-flash-model-name
# AI_RATE_LIMIT_PER_HOUR=30
