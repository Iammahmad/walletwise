# Firebase web-app configuration. These identifiers are public; Firestore Security Rules protect data.
# When any required value is absent, WalletWise remains fully usable in local-only mode.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
EXPO_PUBLIC_FIREBASE_APP_ID=replace_me
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
EXPO_PUBLIC_FIREBASE_FUNCTIONS_ENABLED=false

# OAuth client IDs created in Google Cloud / Firebase Authentication.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_me.apps.googleusercontent.com

# HTTPS origin that hosts /invite/:token and opens the WalletWise app through App/Universal Links.
# If omitted, shared invitations use the walletwise:// custom scheme.
EXPO_PUBLIC_INVITE_BASE_URL=https://walletwise.example.com

# Cloud Function secrets. Configure with Firebase Secret Manager; never prefix them EXPO_PUBLIC_.
# GEMINI_API_KEY=replace_me
# GEMINI_MODEL=replace_me
