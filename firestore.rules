rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAllowedPrivateCollection(privateCollection) {
      return privateCollection in [
        'accounts',
        'categories',
        'budgetCategories',
        'transactions',
        'budgets',
        'savings',
        'splitContacts',
        'splits',
        'splitSettlements',
        'pushTokens'
      ];
    }

    match /users/{userId} {
      allow read: if ownsUserPath(userId);
      allow create, update: if ownsUserPath(userId)
        && request.resource.data.user_id == userId;
      allow delete: if ownsUserPath(userId);

      match /{privateCollection}/{documentId} {
        allow read: if ownsUserPath(userId)
          && isAllowedPrivateCollection(privateCollection);
        allow create, update: if ownsUserPath(userId)
          && isAllowedPrivateCollection(privateCollection)
          && request.resource.data.user_id == userId;
        allow delete: if ownsUserPath(userId)
          && isAllowedPrivateCollection(privateCollection);
      }
    }

    match /splits/{splitId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participant_uids;
      allow write: if false;
    }

    match /connections/{connectionId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participant_uids;
      allow write: if false;
    }

    match /connectionInvites/{token} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
